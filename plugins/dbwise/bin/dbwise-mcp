#!/bin/sh
# Picks a Python 3.12 to 3.14 and hands over to the bootstrap, which builds the environment on first use.
d=$(dirname "$0")
for py in python3.14 python3.13 python3.12 python3 python; do
  if "$py" -c 'import sys; sys.exit(0 if (3, 12) <= sys.version_info[:2] < (3, 15) else 1)' </dev/null >/dev/null 2>&1; then
    exec "$py" "$d/../scripts/bootstrap.py" --run-mcp "$@"
  fi
done
echo "dbwise: needs Python 3.12 to 3.14; tried python3.14, python3.13, python3.12, python3, python. Install one and try again." >&2
exit 1
